{
  "schemaVersion": 2,
  "seed": 42,
  "decisionRule": "common_utc_midnight_after_feature_day",
  "labelRule": "first_valid_steam_quote_168_to_192_hours_after_decision",
  "testDays": 28,
  "validationDays": 28,
  "calibrationDays": 14,
  "purgeDays": 8,
  "budgetCents": 100000,
  "badFoldThreshold": 7.5,
  "minQuoteAgeHours": 0,
  "maxQuoteAgeHours": 24,
  "featureRoundingDecimals": 12,
  "minRequiredHistoryDays": 30,
  "medianCandidates": ["hist_leaf15", "lightgbm_leaf15"],
  "quantiles": [0.1, 0.5, 0.9],
  "hgb": {"max_iter": 200, "learning_rate": 0.05, "max_leaf_nodes": 15, "min_samples_leaf": 30, "l2_regularization": 10, "early_stopping": false},
  "lightgbm": {"n_estimators": 200, "learning_rate": 0.05, "num_leaves": 15, "min_child_samples": 30, "reg_lambda": 10, "deterministic": true, "force_col_wise": true, "verbosity": -1, "n_jobs": 4},
  "ranker": {"n_estimators": 200, "learning_rate": 0.05, "num_leaves": 7, "min_child_samples": 30, "reg_lambda": 10, "label_gain": [0, 1, 2, 3, 4], "deterministic": true, "force_col_wise": true, "verbosity": -1, "n_jobs": 4},
  "rankRelevanceLevels": 5,
  "classifier": "hist_gradient_boosting_plus_disjoint_time_sigmoid",
  "riskFilterThreshold": 0.5,
  "weeklyDecisionStepDays": 7,
  "solver": {"name": "ortools_cp_sat", "max_time_in_seconds": 2, "num_search_workers": 1},
  "medianSelectionRule": "lowest_validation_realized_fold_among_candidates_with_at_least_90pct_baseline_wallet_coverage_then_relative_net_error",
  "minimumValidationWalletCoverage": 0.9,
  "testEvaluatedAfterValidationOnly": true,
  "minimumOneUnitAcrossPlatforms": false,
  "maximumUnitsPerItemAcrossPlatforms": 1,
  "deployRefitRoles": ["train", "validation"],
  "previousModelsOverwritten": false
}
